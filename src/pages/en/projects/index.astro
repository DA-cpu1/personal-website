---
import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'selected', text: 'Project archive' },
  { depth: 2, slug: 'github', text: 'GitHub' }
]
---

<PageLayout title='Projects' {headings}>
  <p>
    This page will present projects I built or meaningfully contributed to, including the problem,
    process, decisions, and outcome.
  </p>

  <h2 id='selected'>Project archive</h2>
  <div class='not-prose my-6 rounded-2xl border border-dashed p-6 sm:p-8'>
    <p class='m-0 text-lg font-medium text-foreground'>The first case study is being prepared</p>
    <p class='mb-0 mt-2 text-muted-foreground'>
      It will appear here when it is ready, without carrying over template examples.
    </p>
  </div>

  <h2 id='github'>GitHub</h2>
  <p>
    Public repositories are available on
    <a href='https://github.com/DA-cpu1' target='_blank' rel='noreferrer'>GitHub</a>.
  </p>
</PageLayout>
